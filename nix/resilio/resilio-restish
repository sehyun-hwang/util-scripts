#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
RESTISH_BIN_DEFAULT=@RESTISH_BIN@
RESTISH_CONFIG_DEFAULT=@RESTISH_CONFIG@
[[ $RESTISH_BIN_DEFAULT != @* ]] || RESTISH_BIN_DEFAULT=restish
[[ $RESTISH_CONFIG_DEFAULT != @* ]] || RESTISH_CONFIG_DEFAULT=$script_dir/restish.json

restish_bin=${RESTISH_BIN:-$RESTISH_BIN_DEFAULT}
restish_config=${RESILIO_RESTISH_CONFIG:-$RESTISH_CONFIG_DEFAULT}
helper_bin=${RESILIO_RESTISH_AUTH_HELPER:-@RESILIO_AUTH_HELPER@}
[[ $helper_bin != @* ]] || helper_bin=$script_dir/resilio-restish-auth.py
response_checker=${RESILIO_RESTISH_RESPONSE_CHECKER:-@RESILIO_RESPONSE_CHECKER@}

fail() { printf 'resilio-restish: %s\n' "$*" >&2; exit 1; }
case ${1:-} in
  status|pause|resume|wait-paused|run-paused)
    export RESILIO_RESTISH_WRAPPER="${BASH_SOURCE[0]}"
    lifecycle=@RESILIO_LIFECYCLE@
    [[ $lifecycle != @* ]] || lifecycle=$script_dir/resilio-lifecycle
    exec bash "$lifecycle" "$@"
    ;;
  -h|--help|'')
    cat <<'EOF'
Usage: resilio-restish [RESTISH_ARGS...]

Runs Restish with the static Resilio API configuration and external request
hook, then checks successful HTTP responses for Resilio application errors.
RESTISH_BIN and RESILIO_RESTISH_* may override packaged paths.
Lifecycle: status; pause|resume|wait-paused FOLDER;
run-paused FOLDER -- COMMAND [ARGS...]. Restores preferences even after failure.
Pause acknowledgement does not imply completed transfer.
EOF
    [[ ${1:-} ]] || exit 2
    exit 0
    ;;
esac

if [[ $restish_bin == */* ]]; then
  [[ -x $restish_bin ]] || fail "Restish executable is not executable: $restish_bin"
else
  restish_bin=$(command -v "$restish_bin") || fail "required command not found: restish"
fi
[[ -r $restish_config ]] || fail "static Restish config is not readable: $restish_config"
[[ -x $helper_bin ]] || fail "auth helper is not executable: $helper_bin"
response_checker_program=${response_checker%% *}
if [[ $response_checker_program == */* ]]; then
  [[ -x $response_checker_program ]] || fail "response checker is not executable: $response_checker_program"
else
  command -v "$response_checker_program" >/dev/null || fail "response checker is not executable: $response_checker_program"
fi

export RSH_CONFIG=$restish_config
export RESILIO_RESTISH_AUTH_HELPER=$helper_bin
"$restish_bin" "$@" | ${response_checker}
